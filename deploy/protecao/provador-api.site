# /etc/nginx/sites-available/provador-api  (ln -s para sites-enabled)
# Depois: certbot --nginx -d api.provadorfit.com.br   (o certbot acrescenta o bloco 443 e o redirecionamento)
server {
    server_name api.provadorfit.com.br;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types application/json text/plain text/css application/javascript;

    client_max_body_size 20m;   # fotos de produto e logo

    # robôs de varredura: nada disto existe aqui (444 fecha a conexão sem responder; o fail2ban conta)
    location ~* (\.php|\.env|\.git|\.aws|\.ds_store|wp-admin|wp-login|wp-content|phpmyadmin|xmlrpc|cgi-bin|/actuator|/vendor/) {
        return 444;
    }

    # login, cadastro e recuperação de senha: 6 por minuto por IP (o app ainda limita por e-mail)
    location ~ ^/api/v1/auth/(login|signup|register|forgot-password|reset-password|check-email|check-slug)/?$ {
        limit_req zone=prov_login burst=6 nodelay;
        limit_conn prov_conn 20;
        include snippets/provador-proxy.conf;
        proxy_read_timeout 30s;
    }

    # scanner de IA: custa cota do Gemini/Groq
    location ^~ /api/v1/ai/ {
        limit_req zone=prov_ia burst=6 nodelay;
        limit_conn prov_conn 10;
        include snippets/provador-proxy.conf;
        proxy_read_timeout 70s;
    }

    location / {
        limit_req zone=prov_geral burst=80 nodelay;
        limit_conn prov_conn 40;
        include snippets/provador-proxy.conf;
        proxy_read_timeout 60s;
    }

    listen [::]:443 ssl http2; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.provadorfit.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.provadorfit.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = api.provadorfit.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name api.provadorfit.com.br;
    return 404; # managed by Certbot


}
