# Copie para /opt/provador/.env.prod no VPS e preencha. NUNCA commitar o .env.prod real.
POSTGRES_USER=provador
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_DE_32_CARACTERES
POSTGRES_DB=provador

# gerar com: openssl rand -hex 32
SECRET_KEY=TROQUE_POR_64_HEX

# lista JSON: app web e o que mais precisar chamar a API
CORS_ORIGINS=["https://app.provadorfit.com.br","https://provadorfit.com.br"]

# nunca "mock" em produção (aprova tudo sem pagamento). Providers PIX válidos: mercadopago, cielo_pix.
PIX_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
